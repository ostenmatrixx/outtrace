# Local infrastructure
POSTGRES_DB=outtrace
POSTGRES_USER=outtrace
POSTGRES_PASSWORD=outtrace_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgres://outtrace:outtrace_dev_only@localhost:5432/outtrace
# Integration tests create and remove an isolated schema in this database.
TEST_DATABASE_URL=postgres://outtrace:outtrace_dev_only@localhost:5432/outtrace
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Development seed. Never use this secret in a deployed environment.
OUTTRACE_SEED_DEVELOPMENT=true
DEV_INGESTION_KEY_ID=dev_local
DEV_INGESTION_KEY=outtrace_dev_ingestion_key
DEV_OPERATOR_KEY_ID=dev_operator
DEV_OPERATOR_KEY=outtrace_dev_operator_key
DEV_WORKSPACE_ID=ws_dev
DEV_CLIENT_ID=client_dev
DEV_PROCESS_ID=process_dev_onboarding
DEV_PROCESS_KEY=client-onboarding

# Worker (optional bounded controls)
WORKER_CONCURRENCY=5
WORKER_LOCK_DURATION_MS=30000
WORKER_SHUTDOWN_TIMEOUT_MS=30000
REDIS_CONNECT_TIMEOUT_MS=10000
PHASE_2_POLL_INTERVAL_MS=1000
PHASE_2_SWEEP_INTERVAL_MS=30000
# Optional. Keep webhook URLs out of source control and configure them only in .env/deployment.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_MINIMUM_SEVERITY=high
DASHBOARD_BASE_URL=http://localhost:5173

# Dashboard
VITE_API_BASE_URL=http://localhost:3000
